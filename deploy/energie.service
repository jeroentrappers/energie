[Unit]
Description=energie home energy controller
Documentation=https://github.com/jeroentrappers/energie/blob/main/docs/INSTALL.md
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=exec
ExecStartPre=/usr/local/bin/energie --check-config /etc/energie/energie.toml
ExecStart=/usr/local/bin/energie --config /etc/energie/energie.toml
Restart=on-failure
RestartSec=5s
Environment=RUST_LOG=info

# Secrets: root-owned 0600 files, handed over read-only under /run/credentials/energie.service/.
# Uncomment what your config uses. A listed file that does not exist stops the service.
# LoadCredential=web-password:/etc/energie/web-password
# LoadCredential=mqtt-password:/etc/energie/mqtt-password
# LoadCredential=ntfy-token:/etc/energie/ntfy-token
# LoadCredential=ha-token:/etc/energie/ha-token
# LoadCredential=homewizard-token:/etc/energie/homewizard-token
# LoadCredential=entsoe-token:/etc/energie/entsoe-token
# LoadCredential=cable-local-key:/etc/energie/cable-local-key
# LoadCredential=cloud-kia:/etc/energie/cloud-kia.json
# LoadCredential=cloud-cupra:/etc/energie/cloud-cupra.json
# LoadCredential=cloud-lgthinq:/etc/energie/cloud-lgthinq.json
# LoadCredential=cloud-fluvius:/etc/energie/cloud-fluvius.json

# Identity and state: a throwaway user, /var/lib/energie owned by it.
DynamicUser=yes
StateDirectory=energie
StateDirectoryMode=0700
WorkingDirectory=/var/lib/energie

# Resources: generous for this program, and small enough for a single-board computer.
MemoryMax=128M
TasksMax=64
CPUQuota=150%

# Hardening.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077

[Install]
WantedBy=multi-user.target
